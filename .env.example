# ── Credentials ───────────────────────────────────────────────────────────────
# Fill in only the ones you have. Any agent whose provider has no key is
# re-homed to the next provider in its fallback ladder (see below), and if no
# provider is available at all that seat runs deterministically offline.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Gateway / router URLs (optional) ──────────────────────────────────────────
# Leave blank to use the standard vendor endpoint:
#   Anthropic  https://api.anthropic.com
#   OpenAI     https://api.openai.com/v1
#   Google     https://generativelanguage.googleapis.com/v1beta/openai
#
# If you route everything through one gateway that speaks the OpenAI protocol,
# LLM_BASE_URL + LLM_API_KEY is often enough. Anthropic traffic needs a
# Messages-API-compatible gateway (it is not OpenAI-shaped).

# ANTHROPIC_BASE_URL=https://your-router.example.com/anthropic
# OPENAI_BASE_URL=https://your-router.example.com/v1
# GEMINI_BASE_URL=https://your-router.example.com/gemini/v1beta/openai

# LLM_BASE_URL=https://your-router.example.com
# LLM_API_KEY=

# ── Per-agent overrides (highest precedence) ──────────────────────────────────
# Use these to pin one seat to a different provider/model or a dedicated key.
# PROVIDER accepts: anthropic | openai | google | gemini | any OpenAI-compatible
# name that has <PROVIDER>_API_KEY + <PROVIDER>_BASE_URL (openrouter, groq, ...).

# AFFINITY_PROVIDER=openai
# AFFINITY_MODEL=gpt-6.1-sol
# AFFINITY_API_KEY=
# AFFINITY_BASE_URL=

# DEVELOPABILITY_PROVIDER=anthropic
# DEVELOPABILITY_MODEL=claude-5.5-sonnet
# SKEPTIC_PROVIDER=anthropic
# SKEPTIC_MODEL=claude-5.5-opus
# PLANNER_PROVIDER=openai
# PLANNER_MODEL=gpt-6.1-sol

# ── Fallbacks when a provider has no key ──────────────────────────────────────
# Per-agent:
# AFFINITY_FALLBACK_PROVIDER=openai
# AFFINITY_FALLBACK_MODEL=gpt-6.1-sol
# Global catch-all appended to every seat's ladder:
# LLM_FALLBACK_PROVIDER=
# LLM_FALLBACK_MODEL=
# To force a seat offline instead of falling back:
# AFFINITY_PROVIDER=off

# ── Extended thinking budgets (Anthropic only) ────────────────────────────────
# Tokens. 0/off/none disables the thinking block entirely.
# Defaults: Skeptic 4096, Developability off (no thinking block).
# SKEPTIC_THINKING_BUDGET=4096
# DEVELOPABILITY_THINKING_BUDGET=off
# AFFINITY_THINKING_BUDGET=off
# PLANNER_THINKING_BUDGET=off
