# Secrets: never commit
.env
.env.local
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Local artifacts
results/*.sqlite3
results/*.sbom.json

# ... except the frozen Seed-21 reference. It is the one artifact a fresh
# checkout cannot regenerate cheaply (it needs a six-round live council run), and
# everything on the stage path — POST /api/restore-golden, POST /api/rewind —
# reads from it. `scripts/promote_golden.py` is the only thing that writes it.
!results/golden_seed21.sqlite3
